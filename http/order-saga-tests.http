  "items": [
    {
      "skuId": "11111111-1111-1111-1111-111111111111",
      "productName": "Demo Product A",
      "quantity": 1,
      "unitPrice": 1200.00,
      "itemTotalPrice": 1200.00
    }
  ]
}


### 7. Payment technical failure
### Payment method starts with 33333333.
### Expected flow:
### POST /orders
###     OrderCreated -> InventoryReserved -> PaymentRequested
###     payment-service throws technical failure => transaction rolls back, retries, then DLT.
###     => order status remains PAYMENT_PENDING.
###     => inventory reservation remains RESERVED.
###  This is correct because technical failure is not a business decline.
POST {{orderBaseUrl}}/orders
Content-Type: application/json
X-Correlation-Id: aaaaaaaa-1111-2222-3333-aaaaaaaaaaba

{
  "requestId": "10000000-0000-0000-0000-000000000006",
  "checkoutId": "20000000-0000-0000-0000-000000000006",
  "customerId": "30000000-0000-0000-0000-000000000006",
  "paymentMethodId": "33333333-0000-0000-0000-000000000006",
  "currency": "DKK",
  "totalAmount": 25.00,
  "items": [
    {
      "skuId": "11111111-1111-1111-1111-111111111111",
      "productName": "Demo Product A",
      "quantity": 1,
      "unitPrice": 25.00,
      "itemTotalPrice": 25.00
    }
  ]
}


### 8. Checkout snapshot validation failure: item total does not match quantity * unit price
### Expected:
### Request rejected by order-service : HTTP 400.
### Expected side effect: No order and no outbox event.
POST {{orderBaseUrl}}/orders
Content-Type: application/json
X-Correlation-Id: aaaaaaaa-1111-2222-3333-aaaaaaaaaabb

{
  "requestId": "10000000-0000-0000-0000-000000000007",
  "checkoutId": "20000000-0000-0000-0000-000000000007",
